{% extends 'base.html.twig' %}
{% block title %}Espace équipe | Clinique du Prétot{% endblock %}
{% block stylesheets %}{{ parent() }}<style>.admin-app{min-height:100vh;display:grid;grid-template-columns:240px 1fr;background:#f3f7f5}.admin-sidebar{display:flex;flex-direction:column;padding:28px 22px;background:#073653;color:#dce9e7}.admin-logo{display:block;width:150px;height:86px;margin:0 auto 58px}.admin-logo img{display:block;width:100%;height:100%;object-fit:contain;mix-blend-mode:screen}.admin-label{margin:0 10px 12px;color:#7fa7a8;font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.admin-menu{display:grid;gap:5px}.admin-menu a{padding:12px 10px;color:#abc2c1;font-size:12px}.admin-menu a:hover,.admin-menu a.is-active{background:#164966;color:#fff}.admin-logout{margin-top:auto;padding:15px 10px;border-top:1px solid #28536a;color:#abc2c1;font-size:11px}.admin-content{width:min(1180px,100%);padding:54px 6%}.admin-top{display:flex;justify-content:space-between;gap:30px;align-items:flex-start}.admin-top h1{margin:8px 0;font-size:38px;line-height:1.05;font-weight:500}.admin-top>div>p:last-child{margin:0;color:#71878a;font-size:13px}.admin-site-link{padding:12px 15px;border:1px solid #0a7f87;color:#0a7f87;font-size:12px;font-weight:700}.admin-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:45px 0}.admin-metrics article,.admin-panel{padding:23px;background:#fff;border:1px solid #dce9e6}.admin-metrics span,.admin-metrics small{display:block;color:#708589;font-size:11px}.admin-metrics strong{display:block;margin:10px 0 3px;font-size:34px;font-weight:500}.admin-metrics .warning{color:#c96d50}.admin-grid{display:grid;grid-template-columns:1.35fr .9fr;gap:14px}.admin-panel{min-height:320px}.panel-heading{display:flex;justify-content:space-between}.panel-heading h2{margin:5px 0 25px;font-size:22px;font-weight:500}.panel-date{color:#087f88;font-size:12px}.task-list{display:grid;gap:0;margin:0;padding:0;list-style:none}.task-list li{display:grid;grid-template-columns:12px 1fr 20px;gap:12px;align-items:start;padding:16px 0;border-top:1px solid #e4edeb}.task-list strong,.task-list small{display:block}.task-list strong{font-size:12px}.task-list small{margin-top:4px;color:#789095;font-size:10px}.task-list b{color:#087f88;font-size:13px}.task-dot{width:9px;height:9px;margin-top:4px;border:2px solid #087f88;border-radius:50%}.task-dot--done{background:#087f88}.admin-panel--teal{background:#087f88;color:#fff;border-color:#087f88}.admin-panel--teal .kicker{color:#bde2dc}.admin-panel--teal h2{margin:20px 0;font-size:29px;line-height:1.05;font-weight:500}.admin-panel--teal h2 em{color:#bde2dc;font-family:'Playfair Display',serif;font-weight:500}.admin-panel--teal>p:not(.kicker){color:#d5efeb;font-size:13px}.admin-panel--teal button{margin-top:12px;padding:11px 14px;border:1px solid #c1e5e0;background:transparent;color:#fff;font-size:11px}@media(max-width:780px){.admin-app{display:block}.admin-sidebar{display:none}.admin-content{padding:32px 7%}.admin-top{display:block}.admin-top h1{font-size:30px}.admin-site-link{display:inline-block;margin-top:20px}.admin-metrics,.admin-grid{grid-template-columns:1fr}.admin-metrics{margin:30px 0 14px}.admin-panel{min-height:0}}</style>{% endblock %}
{% block body %}
<div class="admin-app">
    <aside class="admin-sidebar"><a class="admin-logo" href="{{ path('clinic_home') }}"><img src="{{ asset('logo.png') }}" alt="Clinique vétérinaire du Prétot"></a><p class="admin-label">Pilotage</p><nav class="admin-menu">
        <a class="is-active" href="{{ path('clinic_admin') }}">Vue d'ensemble</a>
        <a href="{{ path('admin_team_index') }}">Équipe</a>
        <a href="{{ path('admin_product_index') }}">Boutique</a>
        <a href="{{ path('admin_partner_index') }}">Partenaires</a>
        <a href="{{ path('admin_advice_index') }}">Conseils</a>
        <a href="{{ path('admin_carousel_index') }}">Carrousel</a>
    </nav><a class="admin-logout" href="{{ path('app_logout') }}">Se déconnecter ↗</a></aside>
    <main class="admin-content" id="contenu">
        <header class="admin-top">
            <div>
                <p class="kicker">Vue d’ensemble · Analyse des contenus</p>
                <h1>Contenus du site.</h1>
                <p>Suivez les publications visibles et accédez directement à leur gestion.</p>
            </div>
            <a class="admin-site-link" href="{{ path('clinic_home') }}">Voir le site public ↗</a>
        </header>

        <section class="admin-metrics" aria-label="Indicateurs de publication">
            <article>
                <span>Produits en ligne</span>
                <strong>{{ products_online }}</strong>
                <small>Articles visibles dans la boutique</small>
                <a class="admin-metric-link" href="{{ path('admin_product_index') }}">Gérer les produits →</a>
            </article>
            <article>
                <span>Articles conseils en ligne</span>
                <strong>{{ articles_online }}</strong>
                <small>Publications visibles sur le site</small>
                <a class="admin-metric-link" href="{{ path('admin_advice_index') }}">Gérer les articles →</a>
            </article>
            <article>
                <span>Contenus visibles</span>
                <strong>{{ content_online }}</strong>
                <small>sur {{ content_total }} contenus gérés</small>
                <a class="admin-metric-link" href="#content-visibility">Voir la répartition ↓</a>
            </article>
        </section>

        <section class="admin-panel admin-analytics" id="content-visibility" aria-labelledby="content-visibility-title">
            <div class="admin-analytics__heading">
                <div>
                    <p class="kicker">Publication</p>
                    <h2 id="content-visibility-title">Visibilité par rubrique</h2>
                </div>
                <p>Éléments en ligne / éléments gérés</p>
            </div>
            <div class="admin-analytics__table-wrap">
                <table class="admin-analytics__table">
                    <thead>
                        <tr><th scope="col">Rubrique</th><th scope="col">En ligne</th><th scope="col">Total</th><th scope="col">Taux</th><th scope="col">Accès</th></tr>
                    </thead>
                    <tbody>
                        {% for content in dashboard_content %}
                            <tr>
                                <th scope="row">{{ content.label }}</th>
                                <td>{{ content.online }}</td>
                                <td>{{ content.total }}</td>
                                <td>
                                    <div class="admin-analytics__bar" role="progressbar" aria-label="Visibilité : {{ content.label }}" aria-valuemin="0" aria-valuemax="{{ content.total > 0 ? content.total : 1 }}" aria-valuenow="{{ content.online }}">
                                        <span style="width: {{ content.total > 0 ? (content.online / content.total * 100)|round : 0 }}%"></span>
                                    </div>
                                </td>
                                <td><a href="{{ path(content.route) }}">Gérer <span aria-hidden="true">↗</span></a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>
{% endblock %}

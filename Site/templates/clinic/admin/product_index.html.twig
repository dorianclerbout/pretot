{% extends 'base.html.twig' %}
{% block title %}Boutique | Espace équipe{% endblock %}
{% block body %}
<div class="admin-app">
    <aside class="admin-sidebar"><a class="admin-logo" href="{{ path('clinic_home') }}"><img src="{{ asset('logo.png') }}" alt="Clinique vétérinaire du Prétot"></a><p class="admin-label">Pilotage</p><nav class="admin-menu"><a href="{{ path('clinic_admin') }}">Vue d'ensemble</a><a href="{{ path('clinic_admin') }}#patients">Patients</a><a href="{{ path('admin_team_index') }}">Équipe</a><a href="{{ path('clinic_admin') }}#stock">Stocks & commandes</a><a href="{{ path('clinic_admin') }}#reports">Rapports</a><a class="is-active" href="{{ path('admin_product_index') }}">Boutique</a><a href="{{ path('admin_partner_index') }}">Partenaires</a><a href="{{ path('admin_advice_index') }}">Conseils</a><a href="{{ path('admin_carousel_index') }}">Carrousel</a></nav><a class="admin-logout" href="{{ path('app_logout') }}">Se déconnecter ↗</a></aside>
    <main class="admin-content">
        <header class="admin-top">
            <div>
                <p class="kicker">Espace équipe · Boutique</p>
                <h1>Les articles de la boutique.</h1>
                <p>Gérez les articles présentés sur la page publique. Aucun paiement n'est traité ici : le client est redirigé vers votre plateforme d'achat.</p>
            </div>
            <a class="admin-site-link" href="{{ path('admin_product_new') }}">Ajouter un article +</a>
        </header>

        {% for message in app.flashes('success') %}
            <p class="admin-flash">{{ message }}</p>
        {% endfor %}

        <section class="admin-panel">
            {% if products is empty %}
                <p>Aucun article pour le moment.</p>
            {% else %}
                <table class="product-table">
                    <thead>
                        <tr>
                            <th>Ordre</th>
                            <th>Nom</th>
                            <th>Prix</th>
                            <th>Lien d'achat</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                            <tr>
                                <td>{{ product.sortOrder }}</td>
                                <td>{{ product.name }}</td>
                                <td>{{ product.price ?: '—' }}</td>
                                <td>{% if product.purchaseUrl %}<a href="{{ product.purchaseUrl }}" target="_blank" rel="noopener">Voir ↗</a>{% else %}—{% endif %}</td>
                                <td>
                                    {% if product.visible %}
                                        <span class="badge badge--on">Visible</span>
                                    {% else %}
                                        <span class="badge badge--off">Masqué</span>
                                    {% endif %}
                                </td>
                                <td class="actions">
                                    <a href="{{ path('admin_product_edit', { id: product.id }) }}">Modifier</a>
                                    <form method="post" action="{{ path('admin_product_delete', { id: product.id }) }}" onsubmit="return confirm('Supprimer cet article ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-product-' ~ product.id) }}">
                                        <button type="submit">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    </main>
</div>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}Carrousel | Espace équipe{% endblock %}
{% block body %}
<div class="admin-app">
    <aside class="admin-sidebar"><a class="admin-logo" href="{{ path('clinic_home') }}"><img src="{{ asset('logo.png') }}" alt="Clinique vétérinaire du Prétot"></a><p class="admin-label">Pilotage</p><nav class="admin-menu"><a href="{{ path('clinic_admin') }}">Vue d'ensemble</a><a href="{{ path('clinic_admin') }}#patients">Patients</a><a href="{{ path('admin_team_index') }}">Équipe</a><a href="{{ path('clinic_admin') }}#stock">Stocks & commandes</a><a href="{{ path('clinic_admin') }}#reports">Rapports</a><a href="{{ path('admin_product_index') }}">Boutique</a><a href="{{ path('admin_partner_index') }}">Partenaires</a><a href="{{ path('admin_advice_index') }}">Conseils</a><a class="is-active" href="{{ path('admin_carousel_index') }}">Carrousel</a></nav><a class="admin-logout" href="{{ path('app_logout') }}">Se déconnecter ↗</a></aside>
    <main class="admin-content">
        <header class="admin-top">
            <div>
                <p class="kicker">Espace équipe · Carrousel</p>
                <h1>Carrousel de l'accueil.</h1>
                <p>Ajoutez, modifiez ou supprimez les images (et leur texte) affichées en page d'accueil.</p>
            </div>
            <a class="admin-site-link" href="{{ path('admin_carousel_new') }}">Ajouter une image +</a>
        </header>

        {% for message in app.flashes('success') %}
            <p class="admin-flash">{{ message }}</p>
        {% endfor %}

        <section class="admin-panel">
            {% if slides is empty %}
                <p>Aucune image pour le moment.</p>
            {% else %}
                <table class="product-table">
                    <thead>
                        <tr><th>Ordre</th><th>Image</th><th>Texte</th><th>Statut</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        {% for slide in slides %}
                            <tr>
                                <td>{{ slide.sortOrder }}</td>
                                <td><div class="current-image"><img src="{{ asset('images/' ~ slide.imageFilename) }}" alt="{{ slide.altText }}"></div></td>
                                <td>{{ slide.caption ?: '—' }}</td>
                                <td>
                                    {% if slide.visible %}
                                        <span class="badge badge--on">Visible</span>
                                    {% else %}
                                        <span class="badge badge--off">Masqué</span>
                                    {% endif %}
                                </td>
                                <td class="actions">
                                    <a href="{{ path('admin_carousel_edit', { id: slide.id }) }}">Modifier</a>
                                    <form method="post" action="{{ path('admin_carousel_delete', { id: slide.id }) }}" onsubmit="return confirm('Supprimer cette image ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-carousel-' ~ slide.id) }}">
                                        <button type="submit">Supprimer</button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </section>
    </main>
</div>
{% endblock %}

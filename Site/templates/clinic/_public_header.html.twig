<div class="notice"><span>{{ clinic.streetAddress }} · {{ clinic.postalCode }} {{ clinic.city }}</span><span>{{ clinic.hoursShort }}</span><a href="tel:{{ clinic.phone }}">{{ clinic.phoneDisplay }}</a></div>
<header class="public-header">
    <a class="main-logo" href="{{ path('clinic_home') }}" aria-label="Accueil de la Clinique vétérinaire du Prétot"><img src="{{ asset(clinic.logoPath) }}" alt="{{ clinic.name }} à {{ clinic.city }}" width="250" height="118"></a>
    <button class="mobile-menu" type="button" aria-label="Ouvrir le menu" data-menu-toggle><span></span><span></span></button>
    <nav class="public-nav" data-menu>
        <a class="{{ active_page == 'home' ? 'is-active' : '' }}" href="{{ path('clinic_home') }}">Accueil</a>
        <a class="{{ active_page == 'about' ? 'is-active' : '' }}" href="{{ path('clinic_about') }}">La clinique</a>
        <a class="{{ active_page == 'services' ? 'is-active' : '' }}" href="{{ path('clinic_services') }}">Services</a>
        <a class="{{ active_page == 'shop' ? 'is-active' : '' }}" href="{{ path('clinic_shop') }}">Boutique</a>
        <a class="{{ active_page == 'advice' ? 'is-active' : '' }}" href="{{ path('clinic_advice') }}">Conseils</a>
        <a class="{{ active_page == 'contact' ? 'is-active' : '' }}" href="{{ path('clinic_contact') }}">Contact</a>
        <a class="team-link" href="{{ path('clinic_admin') }}" rel="nofollow">Espace équipe ↗</a>
    </nav>
</header>
{% include 'clinic/_breadcrumbs.html.twig' %}

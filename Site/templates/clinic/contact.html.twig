{% extends 'base.html.twig' %}
{% set breadcrumbs = [{name: 'Contact', url: url('clinic_contact')}] %}
{% block title %}Contact et rendez-vous | Vétérinaire à Granville{% endblock %}
{% block meta_description %}Adresse, horaires et téléphone de la Clinique vétérinaire du Prétot à Granville. Prenez rendez-vous ou appelez les urgences 24 h/24.{% endblock %}
{% block body %}{% set real_photos = 'images/wetransfer_image00001-jpeg_2026-09-22_0817/' %}<div class="public-site">{% include 'clinic/_public_header.html.twig' %}<main class="public-page" id="contenu">

<section class="page-hero page-hero--image">
    <div>
        <p class="kicker">Nous trouver</p>
        <h1>Parlons de<br><em>votre compagnon.</em></h1>
        <p>Une question, une urgence, un rendez-vous à prendre ? Notre équipe vous répond du lundi au samedi.</p>
        <div class="cover-actions"><a class="emergency-link emergency-link--phone" href="tel:{{ clinic.phone }}"><span class="emergency-link__label">Nous appeler</span><strong>{{ clinic.phoneDisplay }}</strong><span aria-hidden="true">↗</span></a></div>
    </div>
    <img src="{{ asset(real_photos ~ 'image00005.jpeg') }}" alt="Entrée de la clinique vétérinaire du Prétot à Granville">
</section>

<section class="section contact-section">
    <div class="section-heading">
        <div><p class="kicker">La clinique</p><h2>Venez nous<br><em>rencontrer.</em></h2></div>
        <p>Installée au cœur de Granville, notre clinique vous accueille dans un cadre calme et chaleureux, pour vous et votre compagnon.</p>
    </div>
    <div class="contact-visual">
        <div class="contact-visual__map">
            <iframe
                src="{{ clinic.mapsEmbedUrl }}"
                title="Localisation de la {{ clinic.name }} à {{ clinic.city }}"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
            ></iframe>
        </div>
        <div class="contact-card">
            <div class="contact-card__row"><span class="contact-card__icon">📍</span><div><strong>{{ clinic.streetAddress }}</strong><small>{{ clinic.postalCode }} {{ clinic.city }}</small></div></div>
            <div class="contact-card__row"><span class="contact-card__icon">📞</span><div><strong>{{ clinic.phoneDisplay }}</strong><small>Rendez-vous et secrétariat</small><strong>{{ clinic.emergencyPhoneDisplay }}</strong><small>Urgences 24 h/24, 7 j/7 avec les cliniques des Îles et de Bréhal</small></div></div>
            <div class="contact-card__row"><span class="contact-card__icon">🕒</span><div><strong>Lun. - ven.</strong><small>8h30 - 12h · 14h - 19h</small><strong>Samedi</strong><small>8h30 - 12h · 14h - 17h</small></div></div>
            <a class="button contact-card__map" href="{{ clinic.mapsPlaceUrl }}" target="_blank" rel="noopener noreferrer">Voir l'itinéraire<span>→</span></a>
        </div>
    </div>
</section>

{% if partners is not empty %}
<section class="section partners">
    <div class="section-heading">
        <div><p class="kicker">Nos partenaires</p><h2>Des professionnels<br><em>de confiance.</em></h2></div>
        <p>Une sélection de professionnels que nous recommandons pour prendre soin de votre compagnon au quotidien.</p>
    </div>
    <div class="product-grid">
        {% for partner in partners %}
            <article class="product-card">
                <div class="product-card__media{{ partner.logoFilename ? '' : ' product-card__media--empty' }}">
                    {% if partner.logoFilename %}<img src="{{ asset('images/' ~ partner.logoFilename) }}" alt="{{ partner.name }}" loading="lazy">{% else %}<span>🐾</span>{% endif %}
                    {% if partner.role %}<span class="product-card__price">{{ partner.role }}</span>{% endif %}
                </div>
                <div class="product-card__body">
                    <h3>{{ partner.name }}</h3>
                    {% if partner.description %}<p>{{ partner.description }}</p>{% endif %}
                    {% if partner.websiteUrl %}<a class="product-card__cta" href="{{ partner.websiteUrl }}" target="_blank" rel="noopener">Visiter le site<span>→</span></a>{% endif %}
                </div>
            </article>
        {% endfor %}
    </div>
</section>
{% endif %}

</main>{% include 'clinic/_public_footer.html.twig' %}</div>{% endblock %}

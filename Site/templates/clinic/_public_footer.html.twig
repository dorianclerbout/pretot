<footer class="public-footer">
	<div class="footer-brand">
		<img src="{{ asset(clinic.logoPath) }}" alt="{{ clinic.name }}" width="165" height="76">
		<p>La santé de vos compagnons,<br>au cœur de {{ clinic.city }}.</p>
	</div>
	<div class="footer-section">
		<p class="footer-label">Nous trouver</p>
		<address>{{ clinic.streetAddress }}<br>{{ clinic.postalCode }} {{ clinic.city }}</address>
	</div>
	<div class="footer-section footer-hours">
		<p class="footer-label">Horaires</p>
		<p><strong>Lun. - ven.</strong><br>8h30 - 12h / 14h - 19h</p>
		<p><strong>Samedi</strong><br>8h30 - 12h / 14h - 17h</p>
	</div>
	<div class="footer-section footer-contact">
		<p class="footer-label">Nous appeler</p>
		<a class="footer-phone" href="tel:{{ clinic.phone }}">{{ clinic.phoneDisplay }}</a>
		<a class="footer-email" href="tel:{{ clinic.emergencyPhone }}">Urgences {{ clinic.emergencyPhoneDisplay }}</a>
	</div>
	<nav class="footer-section footer-links" aria-label="Liens utiles">
		<p class="footer-label">Liens utiles</p>
		<a href="{{ path('clinic_about') }}">La clinique</a>
		<a href="{{ path('clinic_services') }}">Services</a>
		<a href="{{ path('clinic_shop') }}">Boutique</a>
		<a href="{{ path('clinic_advice') }}">Conseils</a>
		<a href="{{ path('clinic_contact') }}">Contact</a>
	</nav>
	<div class="footer-bottom">
		<span>© {{ 'now'|date('Y') }} Clinique vétérinaire du Prétot</span>
		<nav aria-label="Liens secondaires"><a href="{{ path('clinic_legal') }}">Mentions légales</a></nav>
	</div>
</footer>

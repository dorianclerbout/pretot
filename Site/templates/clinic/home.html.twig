{% extends 'base.html.twig' %}

{% block title %}Clinique vétérinaire du Prétot | Granville{% endblock %}

{% block body %}
<div class="public-site">
    {% include 'clinic/_public_header.html.twig' %}
    <main id="accueil">
        <section class="cover-grid">
            <div class="cover-copy"><p class="kicker">Santé · bienveillance · proximité</p><h1>Au service<br><em>de vos compagnons,</em><br>à Granville.</h1><p class="cover-intro">Une équipe attentive et bienveillante au service du bien-être et de la santé de vos animaux de compagnie.</p><div class="cover-actions"><a class="outline-link" href="{{ path('clinic_services') }}">Découvrir nos soins <span>→</span></a><a class="emergency-link emergency-link--phone" href="tel:+33233501818"><span class="emergency-link__label">Appel urgences</span><strong>02 33 50 18 18</strong><span aria-hidden="true">↗</span></a></div><div class="cover-details"><span>Lun. - ven. 8h30 - 12h<br>14h - 19h · Sam. jusqu'à 17h</span><span>Urgences assurées 24 h/24, 7 j/7<br>avec les cliniques des Îles et de Bréhal</span></div></div>
            <div class="cover-brand"><div class="brand-frame"><img src="{{ asset('images/hero-dog.jpg') }}" alt="Golden retriever suivi avec attention par la clinique vétérinaire"></div><p>Une présence attentive<br>pour vos compagnons.</p></div>
        </section>
    
        <section class="story section" id="clinique"><div><p class="kicker">La clinique</p><h2>Soigner, expliquer,<br><em>accompagner.</em></h2></div><div class="story-copy"><p>Au Prétot, chaque consultation commence par une écoute attentive. Vos vétérinaires ont à cœur de prévenir l'apparition des maladies et de soigner au mieux vos compagnons.</p><p>Une clinique à taille humaine, installée à Granville, où la compétence médicale s'accorde avec la douceur.</p><a class="text-arrow" href="{{ path('clinic_contact') }}">Nous rencontrer <span>↗</span></a></div></section>
        <section class="services section" id="services"><div class="section-heading"><div><p class="kicker">Nos expertises</p><h2>Tout au long<br><em>de leur vie.</em></h2></div><p>Des soins essentiels et spécialisés pour préserver leur santé, leur confort et votre tranquillité.</p></div><div class="service-list"><article class="service-item service-item--accent"><span>01</span><div><h3>Médecine générale</h3><p>Consultation, diagnostic et suivi personnalisé.</p></div><a href="#contact" aria-label="En savoir plus sur la médecine générale">↗</a></article><article class="service-item"><span>02</span><div><h3>Prévention & vaccination</h3><p>Les bons réflexes pour une vie longue et sereine.</p></div><a href="#contact" aria-label="En savoir plus sur la prévention et la vaccination">↗</a></article><article class="service-item"><span>03</span><div><h3>Chirurgie</h3><p>Des interventions adaptées à chaque animal.</p></div><a href="#contact" aria-label="En savoir plus sur la chirurgie">↗</a></article><article class="service-item"><span>04</span><div><h3>Imagerie</h3><p>Des examens pour affiner le diagnostic.</p></div><a href="#contact" aria-label="En savoir plus sur l'imagerie">↗</a></article><article class="service-item"><span>05</span><div><h3>Analyses</h3><p>Des analyses pour orienter le diagnostic et le suivi.</p></div><a href="#contact" aria-label="En savoir plus sur les analyses">↗</a></article><article class="service-item"><span>06</span><div><h3>Nutrition & comportement</h3><p>Comprendre leurs besoins pour mieux les accompagner.</p></div><a href="#contact" aria-label="En savoir plus sur la nutrition et le comportement">↗</a></article></div></section>
        <section class="advice section" id="conseils"><div class="advice-card"><p class="kicker">Le carnet du Prétot</p><h2>Les petits conseils<br><em>qui changent tout.</em></h2><p>Vaccination, alimentation, prévention : retrouvez les repères utiles pour prendre soin de votre compagnon au quotidien.</p><a class="outline-link outline-link--light" href="{{ path('clinic_contact') }}">Parler à l'équipe <span>→</span></a></div><div class="advice-mark">♡<small>Prendre soin<br>avec justesse</small></div></section>
        {% include 'clinic/_team_section.html.twig' %}
        <section class="google-reviews section" aria-labelledby="google-reviews-title">
            <div class="google-reviews__inner">
                <div>
                    <p class="kicker">Vos retours</p>
                    <h2 id="google-reviews-title">Les avis Google</h2>
                </div>
                <p>Découvrez les retours des personnes qui nous confient leurs compagnons, directement sur Google.</p>
               
            </div>
        </section>
    </main>
    {% include 'clinic/_public_footer.html.twig' %}
</div>
{% endblock %}

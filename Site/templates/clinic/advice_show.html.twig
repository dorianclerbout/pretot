{% extends 'base.html.twig' %}
{% set breadcrumbs = [
    {name: 'Conseils', url: url('clinic_advice')},
    {name: article.title, url: url('clinic_advice_show', {slug: article.slug})}
] %}
{% block title %}{{ article.title }} | Conseils vétérinaires Granville{% endblock %}
{% block meta_description %}{{ article.excerpt|striptags|replace({'\n': ' '})|slice(0, 155) }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_image %}{{ article.imageFilename ? absolute_url(asset('images/' ~ article.imageFilename)) : absolute_url(asset(clinic.ogImagePath)) }}{% endblock %}
{% block extra_json_ld %}
    <script type="application/ld+json">{{ clinic.jsonLd(clinic.article(article.title, article.excerpt|striptags, url('clinic_advice_show', {slug: article.slug}), article.imageFilename ? absolute_url(asset('images/' ~ article.imageFilename)) : absolute_url(asset(clinic.ogImagePath)), absolute_url(asset(clinic.logoPath))))|raw }}</script>
{% endblock %}
{% block body %}<div class="public-site">{% include 'clinic/_public_header.html.twig' %}<main class="public-page" id="contenu">

<section class="page-hero page-hero--image">
    <div>
        <p class="kicker">Le carnet du Prétot</p>
        <h1>{{ article.title }}</h1>
        <p>{{ article.excerpt }}</p>
    </div>
    {% if article.imageFilename %}<img src="{{ asset('images/' ~ article.imageFilename) }}" alt="{{ article.title }}">{% else %}<img src="{{ asset('images/advice-cat.jpg') }}" alt="{{ article.title }}">{% endif %}
</section>

<section class="section article-body">
    {% for paragraph in article.content|split('\n\n') %}
        {% if paragraph|trim is not empty %}<p>{{ paragraph }}</p>{% endif %}
    {% endfor %}
    <a class="text-arrow" href="{{ path('clinic_advice') }}">← Retour aux conseils</a>
</section>

</main>{% include 'clinic/_public_footer.html.twig' %}</div>{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}Boutique | Clinique vétérinaire du Prétot{% endblock %}
{% block body %}<div class="public-site">{% include 'clinic/_public_header.html.twig' %}<main class="public-page"><section class="page-hero page-hero--image"><div><p class="kicker">Boutique</p><h1>Nos produits<br><em>recommandés.</em></h1><p>Une sélection d'articles pensés pour la santé et le bien-être de vos compagnons. Les commandes sont passées sur notre plateforme partenaire, en toute sécurité.</p>{% if purchase_platform_url %}<a class="outline-link shop-platform-link" href="{{ purchase_platform_url }}" target="_blank" rel="noopener">Accéder à la plateforme d'achat<span>→</span></a>{% endif %}</div><img src="{{ asset('images/hero-dog.jpg') }}" alt="Chien entouré de produits de soin"></section><section class="section"><div class="section-heading"><div><p class="kicker">Notre sélection</p><h2>Des articles choisis<br><em>avec soin.</em></h2></div></div>{% if products is empty %}<p class="product-empty">Aucun article n'est disponible pour le moment. Revenez bientôt !</p>{% else %}<div class="product-grid">{% for product in products %}<article class="product-card"><div class="product-card__media{{ product.imageFilename ? '' : ' product-card__media--empty' }}">{% if product.imageFilename %}<img src="{{ asset('images/' ~ product.imageFilename) }}" alt="{{ product.name }}" loading="lazy">{% else %}<span>🐾</span>{% endif %}{% if product.price %}<span class="product-card__price">{{ product.price }}{% if '€' not in product.price %} €{% endif %}</span>{% endif %}</div><div class="product-card__body"><h3>{{ product.name }}</h3>{% if product.description %}<p>{{ product.description }}</p>{% endif %}<a class="product-card__cta" href="{{ product.purchaseUrl ?: purchase_platform_url }}" target="_blank" rel="noopener">En savoir plus<span>→</span></a></div></article>{% endfor %}</div>{% endif %}</section></main>{% include 'clinic/_public_footer.html.twig' %}</div>{% endblock %}

{% extends 'base.html.twig' %}
{% set breadcrumbs = [{name: 'Boutique', url: url('clinic_shop')}] %}
{% block title %}Boutique animale | Clinique vétérinaire du Prétot Granville{% endblock %}
{% block meta_description %}Alimentation, soins et accessoires recommandés par la Clinique vétérinaire du Prétot à Granville. Commandez sur la plateforme partenaire.{% endblock %}
{% block body %}{% set real_photos = 'images/wetransfer_image00001-jpeg_2026-09-22_0817/' %}<div class="public-site">{% include 'clinic/_public_header.html.twig' %}<main class="public-page" id="contenu"><section class="page-hero page-hero--image"><div><p class="kicker">Boutique</p><h1>Nos produits<br><em>recommandés.</em></h1><p>Une sélection d'articles pensés pour la santé et le bien-être de vos compagnons. Les commandes sont passées sur notre plateforme partenaire, en toute sécurité.</p>{% if purchase_platform_url %}<a class="outline-link shop-platform-link" href="{{ purchase_platform_url }}" target="_blank" rel="noopener">Accéder à la plateforme d'achat<span>→</span></a>{% endif %}</div><img src="{{ asset(real_photos ~ 'image00024.jpeg') }}" alt="Rayon de produits alimentaires et de soins pour animaux"></section><section class="section"><div class="section-heading"><div><p class="kicker">Notre sélection</p><h2>Des articles choisis<br><em>avec soin.</em></h2></div></div>{% if products is empty %}<p class="product-empty">Aucun article n'est disponible pour le moment. Revenez bientôt !</p>{% else %}<div class="product-grid">{% for product in products %}<article class="product-card"><div class="product-card__media{{ product.imageFilename ? '' : ' product-card__media--empty' }}">{% if product.imageFilename %}<img src="{{ asset('images/' ~ product.imageFilename) }}" alt="{{ product.name }}" loading="lazy">{% else %}<span>🐾</span>{% endif %}</div><div class="product-card__body"><h3>{{ product.name }}</h3>{% if product.description %}<p>{{ product.description }}</p>{% endif %}<a class="product-card__cta" href="{{ product.purchaseUrl ?: purchase_platform_url }}" target="_blank" rel="noopener">En savoir plus<span>→</span></a></div></article>{% endfor %}</div>{% endif %}</section></main>{% include 'clinic/_public_footer.html.twig' %}</div>{% endblock %}

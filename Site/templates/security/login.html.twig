{% extends 'base.html.twig' %}

{% block title %}Connexion équipe | Clinique du Prétot{% endblock %}

{% block body %}
<main class="login-page">
    <section class="login-card">
        <a class="login-logo" href="{{ path('clinic_home') }}"><img src="{{ asset('logo.png') }}" alt="Clinique vétérinaire du Prétot"></a>
        <p class="eyebrow"><span></span> Espace équipe</p>
        <h1>Bienvenue<br><em>à la clinique.</em></h1>
        {% if error %}<p class="login-error">Identifiants incorrects. Vérifiez votre adresse et votre mot de passe.</p>{% endif %}
        <form method="post" class="login-form">
            <label for="username">Identifiant</label>
            <input id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
            <label for="password">Mot de passe</label>
            <input id="password" type="password" name="_password" autocomplete="current-password" required>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button class="button button--primary" type="submit">Ouvrir le tableau de bord <span>↗</span></button>
        </form>
        <a class="login-back" href="{{ path('clinic_home') }}">← Retour au site public</a>
    </section>
</main>
{% endblock %}
